# Copie para .env e troque TODOS os valores. O .env nunca vai para o git.

ENVIRONMENT=development

# Postgres: superusuário (carga de dados) e usuário da aplicação (privilégio mínimo)
POSTGRES_USER=commerceops_admin
POSTGRES_PASSWORD=troque-esta-senha
APP_DB_USER=commerceops_app
APP_DB_PASSWORD=troque-esta-senha-tambem

# Usado pelos scripts de carga, fora do Docker
ADMIN_DATABASE_URL=postgresql://commerceops_admin:troque-esta-senha@localhost:5432/commerceops
# Usado pela API rodando fora do Docker (no compose, é montado automaticamente)
DATABASE_URL=postgresql://commerceops_app:troque-esta-senha-tambem@localhost:5432/commerceops

# Chave do HMAC que pseudonimiza order_id em traces e logs. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
ORDER_ID_HMAC_KEY=

# Langfuse (opcional; sem chaves o tracing fica desligado)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# LLM: Groq, plano gratuito (decisão D9). Chave em https://console.groq.com > API Keys.
# LLM_MODEL: escolha um modelo da lista atual em https://console.groq.com/docs/models
# (o catálogo gratuito muda; registre o modelo usado em cada experimento).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
# Alternativa local (perfil local-llm do compose):
# LLM_BASE_URL=http://localhost:11434/v1
